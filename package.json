{
  "name": "maximo-fps",
  "private": true,
  "version": "0.1.0",
  "description": "Optimizador de Windows con ajustes reversibles y monitor de hardware",
  "author": "Maximo FPS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.maximofps.desktop",
    "productName": "Máximo FPS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/data/tweaks.json",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": "dir",
      "category": "Utility"
    },
    "artifactName": "Maximo-FPS-Setup-${version}.${ext}"
  }
}
